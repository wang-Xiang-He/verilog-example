digraph "full_adder" {
label="full_adder";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="c2", color="black", fontcolor="black"];
n2 [ shape=diamond, label="c1", color="black", fontcolor="black"];
n3 [ shape=diamond, label="s1", color="black", fontcolor="black"];
n4 [ shape=octagon, label="cout", color="black", fontcolor="black"];
n5 [ shape=octagon, label="sum", color="black", fontcolor="black"];
n6 [ shape=octagon, label="cin", color="black", fontcolor="black"];
n7 [ shape=octagon, label="b", color="black", fontcolor="black"];
n8 [ shape=octagon, label="a", color="black", fontcolor="black"];
c12 [ shape=record, label="{{<p9> A|<p10> B}|$3\n$or|{<p11> Y}}",  ];
c14 [ shape=record, label="{{<p8> a|<p7> b}|ha2\nha|{<p13> carry|<p5> sum}}",  ];
c15 [ shape=record, label="{{<p8> a|<p7> b}|ha1\nha|{<p13> carry|<p5> sum}}",  ];
c14:p13:e -> n1:w [color="black", fontcolor="black", label=""];
n1:e -> c12:p10:w [color="black", fontcolor="black", label=""];
c15:p13:e -> n2:w [color="black", fontcolor="black", label=""];
n2:e -> c12:p9:w [color="black", fontcolor="black", label=""];
c15:p5:e -> n3:w [color="black", fontcolor="black", label=""];
n3:e -> c14:p8:w [color="black", fontcolor="black", label=""];
c12:p11:e -> n4:w [color="black", fontcolor="black", label=""];
c14:p5:e -> n5:w [color="black", fontcolor="black", label=""];
n6:e -> c14:p7:w [color="black", fontcolor="black", label=""];
n7:e -> c15:p7:w [color="black", fontcolor="black", label=""];
n8:e -> c15:p8:w [color="black", fontcolor="black", label=""];
}
digraph "ha" {
label="ha";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="carry", color="black", fontcolor="black"];
n2 [ shape=octagon, label="sum", color="black", fontcolor="black"];
n3 [ shape=octagon, label="b", color="black", fontcolor="black"];
n4 [ shape=octagon, label="a", color="black", fontcolor="black"];
c8 [ shape=record, label="{{<p5> A|<p6> B}|$2\n$and|{<p7> Y}}",  ];
c9 [ shape=record, label="{{<p5> A|<p6> B}|$1\n$xor|{<p7> Y}}",  ];
c8:p7:e -> n1:w [color="black", fontcolor="black", label=""];
c9:p7:e -> n2:w [color="black", fontcolor="black", label=""];
n3:e -> c8:p6:w [color="black", fontcolor="black", label=""];
n3:e -> c9:p6:w [color="black", fontcolor="black", label=""];
n4:e -> c8:p5:w [color="black", fontcolor="black", label=""];
n4:e -> c9:p5:w [color="black", fontcolor="black", label=""];
}
